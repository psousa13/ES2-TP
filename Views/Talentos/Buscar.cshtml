@model IEnumerable<Talento>

@{
    ViewData["Title"] = "Buscar Perfis de Talento";
    var propostas = ViewBag.Propostas as SelectList;
    var selectedPropostaId = Context.Request.Query["propostaId"].ToString();
}

<h1>Buscar Perfis de Talento</h1>

@if (TempData["Aviso"] != null)
{
    <div class="alert alert-warning">@TempData["Aviso"]</div>
}

@if (TempData["Sucesso"] != null)
{
    <div class="alert alert-success">@TempData["Sucesso"]</div>
}

<form asp-controller="Talentos" asp-action="Buscar" method="get" class="row g-3 align-items-end w-75 mb-4">
    <div class="col-md-8">
        <label class="form-label fw-semibold">Selecionar Proposta</label>
        <select name="propostaId" class="form-select">
            <option value="">-- Escolha uma proposta --</option>
            @if (propostas != null)
            {
                foreach (var item in propostas)
                {
                    if (item.Value == selectedPropostaId)
                    {
                        <option value="@item.Value" selected>@item.Text</option>
                    }
                    else
                    {
                        <option value="@item.Value">@item.Text</option>
                    }
                }
            }
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-success w-100">Buscar</button>
    </div>
</form>

<h3>Resultados</h3>

@if (!Model.Any())
{
    <p class="text-muted">Nenhum talento encontrado.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Email</th>
                <th>Categoria</th>
                <th>Preço/Hora</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.IdUtilizadorNavigation?.PrimeiroNome @item.IdUtilizadorNavigation?.Apelido</td>
                    <td>@item.IdUtilizadorNavigation?.Email</td>
                    <td>@(item.Categoria ?? "-")</td>
                    <td>@(item.PrecoHora.HasValue ? item.PrecoHora.Value.ToString("F2") + " €/h" : "-")</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.IdTalento" class="btn btn-sm btn-info">Detalhes</a>
                        @if (!string.IsNullOrEmpty(selectedPropostaId))
                        {
                            <form asp-controller="OfertasEmprego" asp-action="Enviar" method="post" class="d-inline ms-1">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="idProposta" value="@selectedPropostaId" />
                                <input type="hidden" name="idTalento" value="@item.IdTalento" />
                                <button type="submit" class="btn btn-sm btn-warning">Enviar Oferta</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
