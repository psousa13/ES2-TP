@model TalentosIT.Web.Models.Talento
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Editar Talento";
    var categorias = ViewData["Categorias"] as List<SelectListItem> ?? new List<SelectListItem>();
}

<h1>Editar Talento</h1>
<hr />

<div class="row">
    <div class="col-md-5">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="IdTalento" />

            <div class="mb-3">
                <label asp-for="PrecoHora" class="form-label">Preço por Hora (€)</label>
                <input asp-for="PrecoHora" class="form-control" type="number" step="0.01" min="0" />
            </div>

            <div class="mb-3">
                <label asp-for="Telefone" class="form-label">Telefone</label>
                <input asp-for="Telefone" class="form-control" />
            </div>

            <div class="mb-3 form-check">
                <input type="checkbox" name="Publico" id="Publico" class="form-check-input"
                       value="true" @(Model.Publico == true ? "checked" : "") />
                <label for="Publico" class="form-check-label">Perfil Público</label>
                <div class="form-text text-muted">Se marcado, o perfil será visível para todos os utilizadores.</div>
            </div>

            <div class="mb-3">
                <input type="submit" value="Guardar" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/tom-select/2.3.1/js/tom-select.complete.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/tom-select/2.3.1/css/tom-select.bootstrap5.min.css" />
    <script>
        new TomSelect('#selectUtilizador', {
            placeholder: 'Pesquisar utilizador...',
            allowEmptyOption: true
        });
    </script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
