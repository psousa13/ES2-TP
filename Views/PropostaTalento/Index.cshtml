@model IEnumerable<TalentosIT.Web.Models.PropostaTalento>

@{
    ViewData["Title"] = "Minhas Solicitações de Trabalho";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Minhas Solicitações de Trabalho</h1>
    <span class="badge bg-dark text-wrap p-2">Perfil: Profissional IT</span>
</div>

<p class="text-muted">
    Abaixo encontram-se as propostas de trabalho para as quais o teu perfil foi selecionado por potenciais clientes. 
    Podes aceitar ou recusar os pedidos pendentes.
</p>

@if (!Model.Any())
{
    <div class="alert alert-info shadow-sm">
        Ainda não recebeste nenhuma solicitação para propostas de trabalho. Certifica que o teu perfil está <strong>Público</strong>.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead class="table-light">
                <tr>
                    <th>Proposta / Título</th>
                    <th>Categoria</th>
                    <th>Horas Estimadas</th>
                    <th>Estado</th>
                    <th>Data da Resposta</th>
                    <th class="text-center" style="width: 220px;">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var solicitacao in Model.OrderByDescending(c => c.Estado == TalentosIT.Web.Models.EstadoProposta.Pendente))
                {
                    <tr>
                        <td>
                            <span class="fw-bold d-block">@solicitacao.IdPropostaNavigation?.Titulo</span>
                            <small class="text-muted">ID Proposta: #@solicitacao.IdProposta</small>
                        </td>
                        <td>@(solicitacao.IdPropostaNavigation?.Categoria ?? "---")</td>
                        <td>@(solicitacao.IdPropostaNavigation?.HorasTotais?.ToString() ?? "---") h</td>
                        <td>
                            @if (solicitacao.Estado == TalentosIT.Web.Models.EstadoProposta.Pendente)
                            {
                                <span class="badge bg-warning text-dark px-2 py-1.5">Pendente</span>
                            }
                            else if (solicitacao.Estado == TalentosIT.Web.Models.EstadoProposta.Aceite)
                            {
                                <span class="badge bg-success px-2 py-1.5">Aceite</span>
                            }
                            else if (solicitacao.Estado == TalentosIT.Web.Models.EstadoProposta.Rejeitada)
                            {
                                <span class="badge bg-danger px-2 py-1.5">Rejeitado</span>
                            }
                        </td>
                        <td>
                            @(solicitacao.DataResposta.HasValue ? solicitacao.DataResposta.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm") : "—")
                        </td>
                        <td class="text-center">
                            @if (solicitacao.Estado == TalentosIT.Web.Models.EstadoProposta.Pendente)
                            {
                                <div class="d-flex gap-2 justify-content-center">
                                    <form asp-controller="PropostaTalento" asp-action="Responder" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="idProposta" value="@solicitacao.IdProposta" />
                                        <input type="hidden" name="idTalento" value="@solicitacao.IdTalento" />
                                        <input type="hidden" name="estado" value="Aceite" />
                                        <button type="submit" class="btn btn-sm btn-success px-3">Aceitar</button>
                                    </form>

                                    <form asp-controller="PropostaTalento" asp-action="Responder" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="idProposta" value="@solicitacao.IdProposta" />
                                        <input type="hidden" name="idTalento" value="@solicitacao.IdTalento" />
                                        <input type="hidden" name="estado" value="Rejeitado" />
                                        <button type="submit" class="btn btn-sm btn-danger px-3">Rejeitar</button>
                                    </form>
                                </div>
                            }
                            else
                            {
                                <span class="text-muted small">Decisão já registada</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}