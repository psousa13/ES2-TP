@model TalentosIT.Web.Models.Cliente
@{
    ViewData["Title"] = "Eliminar Cliente";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Eliminar Cliente</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">← Voltar</a>
</div>

<div class="alert alert-danger">
    <strong>Atenção!</strong> Tem a certeza que pretende eliminar este cliente?
</div>

<dl class="row" style="max-width:500px;">
    <dt class="col-sm-4">Nome</dt>
    <dd class="col-sm-8">@Model.PrimeiroNome @Model.Apelido</dd>
    <dt class="col-sm-4">Email</dt>
    <dd class="col-sm-8">@Model.Email</dd>
    <dt class="col-sm-4">Cidade</dt>
    <dd class="col-sm-8">@(Model.Cidade ?? "—")</dd>
    <dt class="col-sm-4">País</dt>
    <dd class="col-sm-8">@(Model.Pais ?? "—")</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="IdCliente" />
    <div class="d-flex gap-2">
        <input type="submit" value="Confirmar Eliminação" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>
