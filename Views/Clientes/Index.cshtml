@model IEnumerable<TalentosIT.Web.Models.Cliente>
@{
    ViewData["Title"] = "Clientes";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Clientes</h1>
    <a asp-action="Create" class="btn btn-primary">+ Novo Cliente</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Nome</th>
            <th>Email</th>
            <th>Telefone</th>
            <th>Cidade</th>
            <th>País</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.PrimeiroNome @item.Apelido</td>
            <td>@item.Email</td>
            <td>@(item.Telefone ?? "—")</td>
            <td>@(item.Cidade ?? "—")</td>
            <td>@(item.Pais ?? "—")</td>
            <td style="white-space:nowrap;">
                <a asp-action="Details" asp-route-id="@item.IdCliente" class="btn btn-sm btn-info">Detalhes</a>
                <a asp-action="Edit" asp-route-id="@item.IdCliente" class="btn btn-sm btn-warning ms-1">Editar</a>
                <a asp-action="Delete" asp-route-id="@item.IdCliente" class="btn btn-sm btn-danger ms-1">Eliminar</a>
            </td>
        </tr>
    }
    </tbody>
</table>
