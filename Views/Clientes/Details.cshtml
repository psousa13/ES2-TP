@model TalentosIT.Web.Models.Cliente
@{
    ViewData["Title"] = "Detalhes do Cliente";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Detalhes do Cliente</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">← Voltar</a>
</div>

<dl class="row" style="max-width:520px;">
    <dt class="col-sm-4">Nome</dt>
    <dd class="col-sm-8">@Model.PrimeiroNome @Model.Apelido</dd>
    <dt class="col-sm-4">Email</dt>
    <dd class="col-sm-8">@Model.Email</dd>
    <dt class="col-sm-4">Telefone</dt>
    <dd class="col-sm-8">@(Model.Telefone ?? "—")</dd>
    <dt class="col-sm-4">Morada</dt>
    <dd class="col-sm-8">@Model.Rua @Model.NumPorta, @Model.Cidade</dd>
    <dt class="col-sm-4">País</dt>
    <dd class="col-sm-8">@(Model.Pais ?? "—")</dd>
</dl>

<div class="d-flex gap-2 mt-3">
    <a asp-action="Edit" asp-route-id="@Model.IdCliente" class="btn btn-warning">Editar</a>
    <a asp-action="Delete" asp-route-id="@Model.IdCliente" class="btn btn-danger">Eliminar</a>
    <a asp-action="Index" class="btn btn-outline-secondary">Voltar à Lista</a>
</div>
