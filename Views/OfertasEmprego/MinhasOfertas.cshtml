@model IEnumerable<TalentosIT.Web.Models.OfertaEmprego>
@using TalentosIT.Web.Models

@{
    ViewData["Title"] = "As Minhas Ofertas de Emprego";
}

<h1>Ofertas de Emprego</h1>

@if (TempData["Aviso"] != null)
{
    <div class="alert alert-warning">@TempData["Aviso"]</div>
}
@if (TempData["Sucesso"] != null)
{
    <div class="alert alert-success">@TempData["Sucesso"]</div>
}

@{
    var pendentes = Model.Where(o => o.Estado == EstadoOferta.Pendente).ToList();
    var respondidas = Model.Where(o => o.Estado != EstadoOferta.Pendente).ToList();
}

<h4 class="mt-3 mb-3">Pendentes (@pendentes.Count)</h4>

@if (!pendentes.Any())
{
    <div class="alert alert-info">Não tem ofertas pendentes.</div>
}
else
{
    <div class="row g-3">
        @foreach (var o in pendentes)
        {
            <div class="col-md-6">
                <div class="card border-warning shadow-sm h-100">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <strong>@o.IdPropostaNavigation.Titulo</strong>
                        <span class="badge bg-warning text-dark">Pendente</span>
                    </div>
                    <div class="card-body">
                        <p class="mb-1 small text-muted">
                            🏢 @o.IdPropostaNavigation.IdClienteNavigation?.PrimeiroNome
                               @o.IdPropostaNavigation.IdClienteNavigation?.Apelido
                        </p>
                        <p class="mb-1 small text-muted">📂 @o.IdPropostaNavigation.Categoria &nbsp;|&nbsp; ⏱ @o.IdPropostaNavigation.HorasTotais h</p>
                        @if (o.IdPropostaNavigation.PropostaSkills.Any())
                        {
                            <div class="mb-2">
                                @foreach (var ps in o.IdPropostaNavigation.PropostaSkills)
                                {
                                    <span class="badge bg-secondary me-1">@ps.IdSkillNavigation?.Nome (@ps.AnosMinimosExperiencia+ anos)</span>
                                }
                            </div>
                        }
                        <p class="small text-muted mb-3">Recebida em: @o.DataEnvio.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
                        <div class="d-flex gap-2">
                            <form asp-action="Responder" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="idOferta" value="@o.IdOferta" />
                                <input type="hidden" name="aceitar" value="true" />
                                <button type="submit" class="btn btn-sm btn-success">✔ Aceitar</button>
                            </form>
                            <form asp-action="Responder" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="idOferta" value="@o.IdOferta" />
                                <input type="hidden" name="aceitar" value="false" />
                                <button type="submit" class="btn btn-sm btn-danger">✘ Recusar</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<h4 class="mt-5 mb-3">Histórico (@respondidas.Count)</h4>

@if (!respondidas.Any())
{
    <div class="alert alert-info">Sem ofertas respondidas ainda.</div>
}
else
{
    <table class="table table-bordered">
        <thead class="table-light">
            <tr>
                <th>Proposta</th>
                <th>Cliente</th>
                <th>Recebida</th>
                <th>Respondida</th>
                <th>Estado</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var o in respondidas)
            {
                <tr>
                    <td>@o.IdPropostaNavigation.Titulo</td>
                    <td>@o.IdPropostaNavigation.IdClienteNavigation?.PrimeiroNome @o.IdPropostaNavigation.IdClienteNavigation?.Apelido</td>
                    <td>@o.DataEnvio.ToLocalTime().ToString("dd/MM/yyyy")</td>
                    <td>@(o.DataResposta?.ToLocalTime().ToString("dd/MM/yyyy") ?? "-")</td>
                    <td>
                        @if (o.Estado == EstadoOferta.Aceite)
                        {
                            <span class="badge bg-success">Aceite</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Recusada</span>
                        }
                    </td>
                    <td>
                        @if (o.Estado == EstadoOferta.Aceite)
                        {
                            <a asp-action="ContactoCliente" asp-route-id="@o.IdOferta" class="btn btn-sm btn-outline-primary">Ver Contacto do Cliente</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<div class="mt-4">
    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">← Voltar ao Dashboard</a>
</div>
