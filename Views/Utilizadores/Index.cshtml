@model IEnumerable<TalentosIT.Web.Models.Utilizador>
@{
    ViewData["Title"] = "Utilizadores";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Gestão de Utilizadores</h1>
    <a asp-action="Create" class="btn btn-primary">+ Novo Utilizador</a>
</div>

<table class="table table-striped">
    <thead>
    <tr>
        <th>Nome</th>
        <th>Email</th>
        <th>Telefone</th>
        <th>Tipo</th>
        <th>Ativo</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.PrimeiroNome @item.Apelido</td>
            <td>@item.Email</td>
            <td>@(item.Telefone ?? "—")</td>
            <td>
                @{
                    var badge = item.TipoUtilizador switch {
                        TalentosIT.Web.Models.TipoUtilizador.Admin => ("Admin", "bg-danger"),
                        TalentosIT.Web.Models.TipoUtilizador.GestorUtilizadores => ("Gestor de Utilizadores", "bg-primary"),
                        TalentosIT.Web.Models.TipoUtilizador.Cliente => ("Cliente", "bg-warning"),
                        _ => ("Profissional", "bg-success")
                    };
                }
                <span class="badge @badge.Item2">@badge.Item1</span>
            </td>
            <td>
                @if (item.Ativo == true)
                {
                    <span class="badge bg-success">Ativo</span>
                }
                else
                {
                    <span class="badge bg-secondary">Inativo</span>
                }
            </td>
            <td style="white-space:nowrap;">
                <a asp-action="Details" asp-route-id="@item.IdUtilizador" class="btn btn-sm btn-info">Detalhes</a>
                <a asp-action="Edit" asp-route-id="@item.IdUtilizador" class="btn btn-sm btn-warning ms-1">Editar</a>
                @if (item.Ativo == true)
                {
                    <form asp-action="Desativar"
                          asp-route-id="@item.IdUtilizador"
                          method="post"
                          style="display:inline;">

                        <button type="submit"
                                class="btn btn-sm btn-danger ms-1"
                                onclick="return confirm('Tem a certeza que pretende desativar esta conta?')">
                            Desativar
                        </button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>