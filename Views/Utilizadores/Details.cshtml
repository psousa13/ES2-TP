@model TalentosIT.Web.Models.Utilizador
@{
    ViewData["Title"] = "Detalhes do Utilizador";
    var badge = Model.TipoUtilizador switch {
        TalentosIT.Web.Models.TipoUtilizador.Admin => ("Admin", "bg-danger"),
        TalentosIT.Web.Models.TipoUtilizador.GestorUtilizadores => ("Cliente", "bg-primary"),
        _ => ("Profissional", "bg-success")
    };
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Detalhes do Utilizador</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">← Voltar</a>
</div>

<dl class="row" style="max-width:500px;">
    <dt class="col-sm-4">Nome</dt>
    <dd class="col-sm-8">@Model.PrimeiroNome @Model.Apelido</dd>

    <dt class="col-sm-4">Email</dt>
    <dd class="col-sm-8">@Model.Email</dd>

    <dt class="col-sm-4">Telefone</dt>
    <dd class="col-sm-8">@(Model.Telefone ?? "—")</dd>

    <dt class="col-sm-4">Tipo</dt>
    <dd class="col-sm-8"><span class="badge @badge.Item2">@badge.Item1</span></dd>

    <dt class="col-sm-4">Estado</dt>
    <dd class="col-sm-8">
        @if (Model.Ativo == true)
        { <span class="badge bg-success">Ativo</span> }
        else
        { <span class="badge bg-secondary">Inativo</span> }
    </dd>
</dl>

<div class="d-flex gap-2 mt-3">
    <a asp-action="Edit" asp-route-id="@Model.IdUtilizador" class="btn btn-warning">Editar</a>
    <a asp-action="Delete" asp-route-id="@Model.IdUtilizador" class="btn btn-danger">Eliminar</a>
    <a asp-action="Index" class="btn btn-outline-secondary">Voltar à Lista</a>
</div>