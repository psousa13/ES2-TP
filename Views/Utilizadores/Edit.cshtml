@model TalentosIT.Web.Models.Utilizador
@{
    ViewData["Title"] = "Editar Utilizador";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Editar Utilizador</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">← Voltar</a>
</div>

<div class="row">
    <div class="col-md-5">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <input type="hidden" asp-for="IdUtilizador" />
            <div class="mb-3">
                <label asp-for="PrimeiroNome" class="form-label">Primeiro Nome</label>
                <input asp-for="PrimeiroNome" class="form-control" />
                <span asp-validation-for="PrimeiroNome" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Apelido" class="form-label">Apelido</label>
                <input asp-for="Apelido" class="form-control" />
                <span asp-validation-for="Apelido" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Telefone" class="form-label">Telefone</label>
                <input asp-for="Telefone" class="form-control" />
                <span asp-validation-for="Telefone" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="TipoUtilizador" class="form-label">Tipo / Role</label>
                <select asp-for="TipoUtilizador" class="form-select">
                    <option value="Utilizador">Profissional (Worker)</option>
                    <option value="GestorUtilizadores">Cliente</option>
                    <option value="Admin">Administrador</option>
                </select>
            </div>
            <div class="mb-3 form-check">
                <input asp-for="Ativo" class="form-check-input" type="checkbox" />
                <label asp-for="Ativo" class="form-check-label">Conta Ativa</label>
            </div>
            <div class="alert alert-info py-2" style="font-size:0.85rem;">
                A palavra-passe não é alterada aqui. O utilizador deve fazê-lo através do seu perfil.
            </div>
            <div class="d-flex gap-2 mt-3">
                <input type="submit" value="Guardar" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
