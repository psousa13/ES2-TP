@model TalentosIT.Web.Models.Utilizador
@{
    ViewData["Title"] = "Eliminar Utilizador";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Eliminar Utilizador</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">← Voltar</a>
</div>

<div class="alert alert-danger">
    <strong>Atenção!</strong> Tem a certeza que pretende eliminar este utilizador?
</div>

<dl class="row" style="max-width:500px;">
    <dt class="col-sm-4">Nome</dt>
    <dd class="col-sm-8">@Model.PrimeiroNome @Model.Apelido</dd>
    <dt class="col-sm-4">Email</dt>
    <dd class="col-sm-8">@Model.Email</dd>
    <dt class="col-sm-4">Tipo</dt>
    <dd class="col-sm-8">@Model.TipoUtilizador</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="IdUtilizador" />
    <div class="d-flex gap-2">
        <input type="submit" value="Confirmar Eliminação" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>
