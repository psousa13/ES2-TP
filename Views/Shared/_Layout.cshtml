<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TalentosIT</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=Syne:wght@600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TalentosIT.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-md">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">TalentosIT</a>

                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto gap-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                        </li>

                        @if (User?.Identity?.IsAuthenticated == true)
                        {
                            @* Skills: visible to all, but Create/Edit/Delete restricted server-side *@
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Skills" asp-action="Index">Skills</a>
                            </li>

                            @* Workers: see talentos (their own profile management) *@
                            @if (User.IsInRole("Utilizador") || User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Talentos" asp-action="Index">Talentos</a>
                                </li>
                            }

                            @* Propostas: clients manage theirs, workers browse all *@
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="PropostaTrabalho" asp-action="Index">Propostas</a>
                            </li>

                            @* Clientes e Utilizadores: admin only *@
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Clientes" asp-action="Index">Clientes</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Utilizadores" asp-action="Index">Utilizadores</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="RegistoAtividade" asp-action="Index">Todos os Registos</a>
                                </li>
                            }

                            @* Registos por utilizador: admin e gestor *@
                            @if (User.IsInRole("Admin") || User.IsInRole("GestorUtilizadores"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="RegistoAtividade" asp-action="PorUtilizador">Registos por Utilizador</a>
                                </li>
                            }

                            @* Relatórios de preços médios mensais *@
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="RelatorioPreco" asp-action="Index">Relatórios</a>
                                </li>
                            }
                        }
                    </ul>

                    <ul class="navbar-nav align-items-center gap-2 ps-3" style="border-left: 1px solid rgba(255,255,255,0.07);">
                        @if (User?.Identity?.IsAuthenticated == true)
                        {
                            var roleLabel = User.IsInRole("Admin") ? "Admin"
                                : User.IsInRole("GestorUtilizadores") ? "Cliente"
                                : "Profissional";
                            var roleBadge = User.IsInRole("Admin") ? "bg-danger"
                                : User.IsInRole("GestorUtilizadores") ? "bg-primary"
                                : "bg-success";
                            <li class="nav-item">
                                <span class="badge @roleBadge">@roleLabel</span>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Perfil" asp-action="Edit">Perfil</a>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Conta" asp-action="Logout" method="post">
                                    <button type="submit" class="btn btn-logout">Logout</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Conta" asp-action="Login">Login</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm px-3" asp-controller="Conta" asp-action="Register">Criar Conta</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer border-top">
        <div class="container">
            &copy; 2026 TalentosIT &mdash;
            <a asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html> 
