@model EditProfileViewModel

@{
    ViewData["Title"] = "Perfil";
}

<h1>Editar Perfil</h1>

<form asp-action="Edit" method="post">
    <div class="form-group">
        <label asp-for="PrimeiroNome" class="control-label"></label>
        <input asp-for="PrimeiroNome" class="form-control"/>
    </div>
    <div class="form-group">
        <label asp-for="Apelido" class="control-label"></label>
        <input asp-for="Apelido" class="form-control"/>
    </div>
    <div class="form-group">
        <label asp-for="Email" class="control-label"></label>
        <input asp-for="Email" class="form-control"/>
    </div>
    <div class="form-group">
        <label asp-for="Telefone" class="control-label"></label>
        <input asp-for="Telefone" class="form-control"/>
    </div>
    <div class="form-group">
        <label asp-for="ConfirmarPalavraPasse" class="control-label">Confirmar Palavra Passe</label>
        <input asp-for="ConfirmarPalavraPasse" class="form-control" type="password" />
        <span asp-validation-for="ConfirmarPalavraPasse" class="text-danger"></span>
    </div>

    <div class="form-group">
        <input type="submit" value="Guardar" class="btn btn-primary" />
    </div>
</form>