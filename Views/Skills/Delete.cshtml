@model TalentosIT.Web.Models.Skill
@{
    ViewData["Title"] = "Eliminar Skill";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Eliminar Skill</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">← Voltar</a>
</div>

<div class="alert alert-danger">
    <strong>Atenção!</strong> Tem a certeza que pretende eliminar esta skill? Esta ação não pode ser desfeita.
</div>

<dl class="row" style="max-width:400px;">
    <dt class="col-sm-4">Nome</dt>
    <dd class="col-sm-8">@Model.Nome</dd>
    <dt class="col-sm-4">Área</dt>
    <dd class="col-sm-8">@Model.AreaProfissional</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="IdSkill" />
    <div class="d-flex gap-2">
        <input type="submit" value="Confirmar Eliminação" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>
