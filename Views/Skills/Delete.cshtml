@model TalentosIT.Web.Models.Skill

@{
    ViewData["Title"] = "Eliminar Skill";
    bool emUso = (bool)(ViewData["EmUso"] ?? false);
}

<h2>Eliminar Skill</h2>

@if (TempData["Erro"] != null)
{
    <div class="alert alert-danger">@TempData["Erro"]</div>
}

@if (emUso)
{
    <div class="alert alert-warning">
        <strong>Não é possível eliminar esta skill</strong> porque está associada a um ou mais perfis de talento ou propostas de trabalho.
        Remova todas as associações primeiro.
    </div>

    <a asp-action="Index" class="btn btn-secondary">← Voltar à Lista</a>
}
else
{
    <div class="alert alert-danger">
        Tem a certeza que quer eliminar esta skill?
    </div>

    <dl class="row w-50">
        <dt class="col-sm-4">Nome</dt>
        <dd class="col-sm-8">@Model.Nome</dd>

        <dt class="col-sm-4">Área Profissional</dt>
        <dd class="col-sm-8">@(Model.AreaProfissional ?? "—")</dd>
    </dl>

    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="IdSkill" />
        <button type="submit" class="btn btn-danger">Eliminar</button>
        <a asp-action="Index" class="btn btn-secondary ms-2">Cancelar</a>
    </form>
}
