@model TalentosIT.Web.Models.Skill
@{
    ViewData["Title"] = "Detalhes da Skill";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>@Model.Nome</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">← Voltar</a>
</div>

<dl class="row" style="max-width:400px;">
    <dt class="col-sm-4">Nome</dt>
    <dd class="col-sm-8">@Model.Nome</dd>
    <dt class="col-sm-4">Área Profissional</dt>
    <dd class="col-sm-8">@Model.AreaProfissional</dd>
</dl>

<div class="d-flex gap-2 mt-3">
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Edit" asp-route-id="@Model.IdSkill" class="btn btn-warning">Editar</a>
        <a asp-action="Delete" asp-route-id="@Model.IdSkill" class="btn btn-danger">Eliminar</a>
    }
    <a asp-action="Index" class="btn btn-outline-secondary">Voltar à Lista</a>
</div>
