@model TalentosIT.Web.Models.Skill
@{
    ViewData["Title"] = "Nova Skill";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Nova Skill</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">← Voltar</a>
</div>

<div class="row">
    <div class="col-md-5">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="mb-3">
                <label asp-for="Nome" class="form-label">Nome</label>
                <input asp-for="Nome" class="form-control" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="AreaProfissional" class="form-label">Área Profissional</label>
                <input asp-for="AreaProfissional" class="form-control" />
                <span asp-validation-for="AreaProfissional" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <input type="submit" value="Criar Skill" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
