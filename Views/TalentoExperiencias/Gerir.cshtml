@model TalentosIT.Web.Models.Talento

@{
    ViewData["Title"] = $"Gerir Experiências — {Model.PrimeiroNome} {Model.Apelido}";
}

<h1>Gerir Experiências</h1>
<p class="text-muted mb-4">@Model.PrimeiroNome @Model.Apelido</p>

@if (TempData["Sucesso"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Sucesso"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Aviso"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        @TempData["Aviso"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Erro"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Erro"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<a asp-action="Create" class="btn btn-primary" asp-route-id="@Model.IdTalento">
    Adicionar Experiência
</a>

@* ── Experiências já associadas ── *@
<h5 class="mt-3">Experiências associadas</h5>

@if (!Model.Experiencia.Any())
{
    <p class="text-muted">Nenhuma experiência associada ainda.</p>
}
else
{
    <table class="table table-bordered table-sm w-75">
        <thead class="table-light">
            <tr>
                <th>Titulo</th>
                <th>Empresa</th>
                <th>Ano de Início</th>
                <th>Ano de Fim</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Experiencia.OrderBy(item => item.AnoInicio))
            {
                <tr>
                    <td>@item.Titulo</td>
                    <td>@item.Empresa</td>
                    <td>@item.AnoInicio</td>
                    <td>@(item.AnoFim?.ToString() ?? "---")</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.IdExperiencia" class="btn btn-sm btn-primary">Editar</a>
                        <a asp-action="Delete" asp-route-id="@item.IdExperiencia" class="btn btn-sm btn-danger">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}


<div class="mt-4">
    <a asp-controller="Talentos" asp-action="Details" asp-route-id="@Model.IdTalento" class="btn btn-secondary">
       ← Voltar ao Perfil
    </a>
</div>
