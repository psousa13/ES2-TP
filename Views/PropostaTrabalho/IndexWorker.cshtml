@model IEnumerable<TalentosIT.Web.Models.PropostaTrabalho>
@{
    ViewData["Title"] = "Propostas Disponíveis";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Propostas Disponíveis</h1>
</div>

<p class="text-muted mb-4">Todas as propostas de trabalho abertas na plataforma. Veja se o seu perfil é elegível.</p>

@if (!Model.Any())
{
    <div class="alert alert-info">Ainda não existem propostas de trabalho publicadas.</div>
}
else
{
    <div class="row g-4">
        @foreach (var p in Model)
        {
            <div class="col-md-6">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">@p.Titulo</h5>
                        <p class="text-muted small mb-1">
                            🏢 @(p.IdClienteNavigation?.PrimeiroNome) @(p.IdClienteNavigation?.Apelido)
                        </p>
                        <p class="text-muted small mb-2">📂 @(p.Categoria ?? "—") &nbsp;|&nbsp; ⏱ @p.HorasTotais h</p>
                        @if (p.PropostaSkills.Any())
                        {
                            <div class="mb-2">
                                @foreach (var ps in p.PropostaSkills)
                                {
                                    <span class="badge bg-secondary me-1">
                                        @ps.IdSkillNavigation?.Nome (@ps.AnosMinimosExperiencia+ anos)
                                    </span>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-muted small fst-italic">Sem skills definidas.</p>
                        }
                        @if (!string.IsNullOrEmpty(p.Descricao))
                        {
                            <p class="card-text small text-muted mt-2">@p.Descricao</p>
                        }
                        <a asp-action="Details" asp-route-id="@p.IdProposta"
                           class="btn btn-sm btn-outline-primary mt-2">Ver detalhes</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
