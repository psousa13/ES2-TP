@model TalentosIT.Web.Models.PropostaTrabalho

@{
    ViewData["Title"] = "Editar Proposta";
}

<h1>Editar Proposta</h1>

<h4>Detalhes da Vaga</h4>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <input type="hidden" asp-for="IdProposta" />
            <input type="hidden" asp-for="IdUtilizador" />

            <div class="form-group mb-3">
                <label asp-for="IdCliente" class="control-label fw-bold">Cliente / Empresa</label>
                <select asp-for="IdCliente" class="form-select" asp-items="ViewBag.IdCliente"></select>
                <span asp-validation-for="IdCliente" class="text-danger"></span>
            </div>
            
            <div class="form-group mb-3">
                <label asp-for="Titulo" class="control-label fw-bold">Título da Vaga</label>
                <input asp-for="Titulo" class="form-control" />
                <span asp-validation-for="Titulo" class="text-danger"></span>
            </div>
            
            <div class="form-group mb-3">
                <label asp-for="Categoria" class="control-label fw-bold">Área / Categoria</label>
                <input asp-for="Categoria" class="form-control" />
                <span asp-validation-for="Categoria" class="text-danger"></span>
            </div>
            
            <div class="form-group mb-3">
                <label asp-for="HorasTotais" class="control-label fw-bold">Total de Horas Previstas</label>
                <input asp-for="HorasTotais" class="form-control" type="number" min="1" />
                <span asp-validation-for="HorasTotais" class="text-danger"></span>
            </div>
            
            <div class="form-group mb-3">
                <label asp-for="Descricao" class="control-label fw-bold">Descrição do Trabalho</label>
                <textarea asp-for="Descricao" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Descricao" class="text-danger"></span>
            </div>
            
            <div class="form-group mt-4 mb-5">
                <input type="submit" value="Guardar Alterações" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-outline-secondary ms-2">Voltar à Lista</a>
            </div>
        </form>
    </div>
</div>
