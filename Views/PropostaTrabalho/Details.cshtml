@model TalentosIT.Web.Models.PropostaTrabalho

@{
    ViewData["Title"] = "Detalhes da Proposta";
}

<h2>Detalhes da Proposta</h2>

@if (TempData["Sucesso"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Sucesso"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Aviso"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show">
        @TempData["Aviso"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <div class="col-md-6">
        <dl class="row">
            <dt class="col-sm-4">Título</dt>
            <dd class="col-sm-8">@Model.Titulo</dd>

            <dt class="col-sm-4">Cliente</dt>
            <dd class="col-sm-8">@Model.IdClienteNavigation?.PrimeiroNome @Model.IdClienteNavigation?.Apelido</dd>

            <dt class="col-sm-4">Categoria</dt>
            <dd class="col-sm-8">@(Model.Categoria ?? "—")</dd>

            <dt class="col-sm-4">Horas Totais</dt>
            <dd class="col-sm-8">@(Model.HorasTotais.HasValue ? $"{Model.HorasTotais} h" : "—")</dd>

            <dt class="col-sm-4">Descrição</dt>
            <dd class="col-sm-8">@(Model.Descricao ?? "—")</dd>
        </dl>
    </div>
</div>

@* Skills exigidas *@
<h5 class="mt-4">Skills Exigidas</h5>
@if (!Model.PropostaSkills.Any())
{
    <p class="text-muted">Nenhuma skill exigida definida.</p>
}
else
{
    <table class="table table-sm w-75">
        <thead class="table-light">
            <tr>
                <th>Skill</th>
                <th>Área Profissional</th>
                <th>Mínimo de Anos de Experiência</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ps in Model.PropostaSkills.OrderBy(ps => ps.IdSkillNavigation?.Nome))
            {
                <tr>
                    <td>@ps.IdSkillNavigation?.Nome</td>
                    <td>@(ps.IdSkillNavigation?.AreaProfissional ?? "—")</td>
                    <td>@ps.AnosMinimosExperiencia</td>
                </tr>
            }
        </tbody>
    </table>
}

<div class="mt-4">
    @if (User.IsInRole("GestorUtilizadores") || User.IsInRole("Admin"))
    {
        <a asp-action="Edit" asp-route-id="@Model.IdProposta" class="btn btn-warning">Editar</a>
        <a asp-controller="PropostaSkills" asp-action="Gerir" asp-route-id="@Model.IdProposta" class="btn btn-primary ms-2">Gerir Skills Exigidas</a>
        <a asp-action="Elegiveis" asp-route-id="@Model?.IdProposta" class="btn btn-warning ms-2">Ver Talentos Elegíveis</a>
    }
    <a asp-action="Index" class="btn btn-secondary ms-2">← Voltar à Lista</a>
</div>
