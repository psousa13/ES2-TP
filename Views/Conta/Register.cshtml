@model TalentosIT.Web.Models.RegisterViewModel

@{
    ViewData["Title"] = "Criar Conta";
}

<h1>Criar Conta</h1>

<form asp-action="Register" method="post">
    <div class="form-group">
        <label asp-for="PrimeiroNome" class="control-label">Primeiro Nome</label>
        <input asp-for="PrimeiroNome" class="form-control"/>
        <span asp-validation-for="PrimeiroNome" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Apelido" class="control-label"></label>
        <input asp-for="Apelido" class="form-control"/>
        <span asp-validation-for="Apelido" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Email" class="control-label"></label>
        <input asp-for="Email" class="form-control"/>
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="PalavraPasse" class="control-label">Palavra Passe</label>
        <input asp-for="PalavraPasse" type="password" class="form-control"/>
        <span asp-validation-for="PalavraPasse" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="ConfirmarPalavraPasse" class="control-label">Confirmar Palavra Passe</label>
        <input asp-for="ConfirmarPalavraPasse" type="password" class="form-control"/>
        <span asp-validation-for="ConfirmarPalavraPasse" class="text-danger"></span>
    </div>

    <div class="form-group">
        <input type="submit" value="Criar Conta" class="btn btn-primary" />
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}